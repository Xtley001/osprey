# Osprey — local environment configuration
# Copy to .env.local and set values. Never commit .env.local to source control.

# ── Network ────────────────────────────────────────────────────────────────────
# Testnet: set to 'true' for safe testing; 'false' for mainnet.
# R6 / OP-09: Real trading requires VITE_ENABLE_REAL_TRADING=true explicitly.
VITE_ENABLE_TESTNET=true
VITE_ENABLE_REAL_TRADING=false

# HL REST + WS endpoints (only needed if overriding defaults)
# VITE_HL_REST_URL=https://api.hyperliquid.xyz
# VITE_HL_WS_URL=wss://api.hyperliquid.xyz/ws
# VITE_HL_TESTNET_REST=https://api.hyperliquid-testnet.xyz
# VITE_HL_TESTNET_WS=wss://api.hyperliquid-testnet.xyz/ws

# ── Features ───────────────────────────────────────────────────────────────────
VITE_ENABLE_AGENT_KEYS=true
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
